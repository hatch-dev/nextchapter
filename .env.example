# ─────────────────────────────────────────────────────────────
# apps/.env.example — copy to apps/.env and fill in.
#
#   cp .env.example .env
#
# apps/.env is git-ignored and is read by api/helpers/functions.php
# (load_env). A real environment variable always wins over a value
# here, so a production host that sets them properly is unaffected
# by this file.
#
# It sits ABOVE api/ deliberately: api/.htaccess rewrites every
# request to index.php, so nothing under api/ is web-readable by
# accident — but a secret should be out of the served tree by
# design, not by side effect.
# ─────────────────────────────────────────────────────────────

# The AI Guide, The Decision Lab's Challenge and decision profile, and
# The Ethics Engine's profile all go through POST /claude, which reads
# this. Without it those features answer 503 with a readable message and
# everything else in the app works normally.
# Create one at https://platform.claude.com/ → API keys.
ANTHROPIC_API_KEY=

# Optional — the defaults in api/config/claude.php are the intended
# settings; these are here for tuning without editing code.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low

# ─────────────────────────────────────────────────────────────
# Outgoing mail
#
# Adding a team member emails them their program links and sign-in
# details (api/core/MemberInvite.php). NOT CONFIGURING THIS IS SAFE:
# with MAIL_HOST empty, every message is recorded in the mail_outbox
# table as 'queued', adding a member still succeeds, and the admin is
# told the invite is waiting rather than being told it was sent. Fill
# these in and queued messages go out on the next attempt.
#
# MAIL_PORT decides the default encryption: 465 → implicit TLS ('ssl'),
# anything else → STARTTLS ('tls'). Set MAIL_ENCRYPTION to override, or
# to 'none' for a local relay that speaks plain SMTP.
#
# Leave MAIL_USERNAME/MAIL_PASSWORD empty for a relay that authorises
# by IP instead of by login.
# ─────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Next Chapter Programs

# The public root of the app, used to build the program links in that
# email. Leave blank to derive it from the request, which is correct on
# XAMPP and any single-host deployment; set it when the app sits behind
# a proxy or a CNAME, because the request's own host header is then the
# proxy's idea of the site rather than the one a member should click.
# APP_URL=https://programs.example.com/apps

# ─────────────────────────────────────────────────────────────
# Notification service — step-completion reports and deadline
# reminders, posted by the apps themselves (js/features/email.js).
# See reference/Directive_Activate_Email_Notifications.md.
#
# The app sends NO authentication header and no API key: Part 3 of
# the contract fixes the eight JSON fields it sends and Part 6
# forbids adding to them. Part 3 names the alternative — carry the
# key in the URL — so the endpoint checks ?k= against this value,
# and the app's NOTIFY_ENDPOINT must be the full URL including it:
#
#   NOTIFY_ENDPOINT = 'https://host/apps/api/notify?k=<NOTIFY_KEY>'
#
# EMPTY IS OFF, NOT OPEN. With no key the endpoint answers 503 and
# sends nothing — a deployment that forgets to set one gets a
# service that is switched off, never one that will mail arbitrary
# HTML to arbitrary addresses for anybody who finds the URL.
# Generate one with:  php -r "echo bin2hex(random_bytes(24));"
# ─────────────────────────────────────────────────────────────
NOTIFY_KEY=

# The completion email attaches the Module Management analytics page
# as a PDF, rendered by headless Chrome so it carries the app's own
# stylesheet (Part 3, kind 'step-complete'). Chrome is looked for in
# the usual places on Windows, Linux and macOS; set this when it is
# somewhere else. With no browser the email still goes, without the
# attachment, and says so in the response.
# CHROME_BIN=

# light (default) | dark. The app itself defaults to dark, which is
# the wrong choice for a document that may be printed.
# NOTIFY_PDF_THEME=light

# ─────────────────────────────────────────────────────────────
# AI Guide (Pinecone Assistant) — POST /guide, Controllers\GuideController.
# The Guide in the Innovation Pipeline, Executive Readiness, Responsible
# AI Governance and AI-Ready Architecture asks a Pinecone assistant per
# program. Server secret: never sent to the browser. Without the key the
# Guide answers "unavailable" and everything else works normally.
# ─────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ASSISTANT_HOST=https://prod-1-data.ke.pinecone.io
PINECONE_ASSISTANT_NAME=nextchapter-innovation-pipeline
# Executive Readiness has its own assistant (16 Oct 2026); the browser never names one, the server picks it by module.
PINECONE_ASSISTANT_NAME_EXEC_READINESS=nextchapter-executive-readiness
PINECONE_ASSISTANT_NAME_AI_GOVERNANCE=nextchapter-responsible-ai-governance
PINECONE_ASSISTANT_NAME_ARCHITECTURE=architecture
PINECONE_MODEL=claude-sonnet-4-5
PINECONE_API_VERSION=2026-07
GUIDE_MAX_QUESTION_CHARS=2000
GUIDE_MAX_CONTEXT_CHARS=300
GUIDE_MAX_HISTORY_MESSAGES=10
GUIDE_MAX_HISTORY_MESSAGE_CHARS=8000
GUIDE_TIMEOUT_MS=60000
